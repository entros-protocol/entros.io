NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com
NEXT_PUBLIC_RELAYER_URL=http://localhost:3001/verify
NEXT_PUBLIC_RELAYER_API_KEY=
NEXT_PUBLIC_WASM_URL=/circuits/entros_hamming.wasm
NEXT_PUBLIC_ZKEY_URL=/circuits/entros_hamming_final.zkey
NEXT_PUBLIC_SIGNING_DIAGNOSTIC=0
NEXT_PUBLIC_SIGNING_DIAGNOSTIC_RPC=

# Local development only. Route executor requests through the Next.js server.
NEXT_PUBLIC_ENTROS_LOCAL_EXECUTOR_PROXY=0
ENTROS_STUDY_LOCAL_PREVIEW=0

# Server-only executor connection used by local proxy routes.
RELAYER_URL=
RELAYER_API_KEY=

# Server-only. 1 runs /verify as paired rounds. Any other value keeps the
# single capture.
ENTROS_PAIRED_VERIFY=0

# Server-only allowlist for the /embed/verify-popup route.
# Map of integrator keys to allowed parent origins. Strict equality match.
# Dev mode allows any integrator key against http://localhost(:port) regardless of this config.
ENTROS_INTEGRATORS_JSON={"example-integrator":{"origins":["https://app.example.com"]},"another-integrator":{"origins":["https://another.example.org"]}}
